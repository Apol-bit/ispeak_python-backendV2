# Safe configuration reference. Python and start_backend.ps1 read process
# environment variables; they do not automatically load a .env file.
# Export settings in your shell/host environment before starting the backend.
ISPEAK_ENV=development
ISPEAK_HOST=127.0.0.1
ISPEAK_PORT=8000
ISPEAK_CORS_ORIGINS=http://localhost:5000
ISPEAK_MAX_UPLOAD_MB=25
# Optional: defaults to 1 active inference per process (integer, minimum 1).
ISPEAK_MAX_CONCURRENT_INFERENCES=1
# Optional: defaults to 30 seconds waiting for an inference slot; not a limit
# on transcription execution time (integer, minimum 1).
ISPEAK_QUEUE_TIMEOUT_SECONDS=30
# Optional: defaults to the project-local models/iSpeak_v5 adapter directory.
# Relative model paths resolve from the Python V2 project directory.
ISPEAK_MODEL_PATH=models/iSpeak_v5
# Optional: defaults to base_model inside the selected adapter directory when
# present, otherwise models/iSpeak_v5/base_model. Needed only to override it.
ISPEAK_BASE_MODEL_PATH=models/iSpeak_v5/base_model
